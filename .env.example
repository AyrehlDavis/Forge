# Feedback loop — Vercel Comments → Vercel-for-Slack → Slack Events API
# → /api/feedback → Claude parser → atrium notify.

# Slack app signing secret. Found in api.slack.com → your app → Basic Info →
# App Credentials. Used to HMAC-verify the X-Slack-Signature header on the
# Events API webhook (v0:{timestamp}:{body} → HMAC-SHA256 → "v0=<hex>").
SLACK_SIGNING_SECRET=

# Anthropic API key for Claude Opus 4.7 (text-only structured-output parsing).
ANTHROPIC_API_KEY=

# Optional. Atrium pane UUID that receives the framed `agent message`
# notification on every parsed comment. If unset, the API logs a warning and
# skips the notification (the feedback-log markdown still writes).
ATRIUM_AYREHL_PANE_ID=

# Optional. Path to the atrium CLI binary. Defaults to the standard install
# location; only set this if atrium lives elsewhere on the host.
ATRIUM_CLI_PATH=

# Parked, unused after the Vercel Comments pivot — kept only as scaffolding
# for the FeedbackWidget snippet in V3 layout in case we ever swap back to a
# third-party overlay tool (e.g. Marker.io) on Azure post-migration.
NEXT_PUBLIC_FEEDBACK_ENABLED=
NEXT_PUBLIC_MARKER_DESTINATION_ID=
