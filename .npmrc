# Block packages published less than 7 days ago
min-release-age=7

# Force npm to fail if developer versions do not match 'engines'
engine-strict=true

# Permit peer-dep mismatches (react-simple-maps@3.0.0 declares React ^16||17||18
# but the project is on React 19). Local installs and Vercel both need this
# until react-simple-maps publishes a React 19 release.
legacy-peer-deps=true
